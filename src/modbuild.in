#!@PREFIX@/libexec/bash
#
# The following build-specific variables are set here and used in libpbuild.bash:
#       BUILD_SCRIPT
#       BUILDBLOCK_DIR
#
#.............................................................................

if (( BASH_VERSINFO[0] < 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] < 3) )); then
        echo "Bash 5.3+ is required." 1>&2
        exit 255
fi

declare -r VERSION='@VERSION@'

unset CDPATH    # unset CDPATH, otherwise 'cd' prints the directory!
IFS=$' \t\n'    # use default IFS

#set  -o errexit
#set  -o errtrace

set   -o pipefail
set   -o nounset
#shopt -s nocaseglob
shopt -s extglob
shopt -s nullglob
shopt -s expand_aliases

# use the same PATH for build sub-packages. See libpbuild.bash.
declare save_PATH="${PATH}"

#
# define modulecmd as alias.
# modulecmd must be in PATH otherwise modbuild fails.
# Note: modulecmd can be in any directory not just in /bin, /usr/bin etc.!
#
# :FIXME: is there a better solution?
declare -- _tmp=''
if ! _tmp=$(command -v modulecmd); then
	echo "Oops: modulecmd not found!" 1>&2
	exit 255
fi
alias 'modulecmd'="LD_PRELOAD='' ${_tmp}"
unset _tmp


# Set PATH and source libstd.bash.
# Note: PATH includes the directories bin und libexec of modbuild! 
mydir=$(cd "$(/usr/bin/dirname "$0")" && pwd -P)
prefix=$(/usr/bin/dirname "${mydir}")
PATH="${prefix}/bin:${prefix}/libexec:/bin:/usr/bin:/sbin:/usr/sbin"
source "${prefix}/lib/libstd.bash" || {
        echo "Oops: cannot source library -- '$_'" 1>&2; exit 3;
}
unset mydir

##
## Exit script on errror.
##
## Arguments:
##   $1 -  exit code
#
_error_handler() {
        local -i ec=$?

        std::die ${ec} "Oops"
}
readonly -f _error_handler
trap "_error_handler" ERR

# :FIXME: move other calls from libstd.bash to this or a better place
std::def_cmd2 'sevenz'

declare -A __PB_EC=()
__PB_EC['ARGS']=1
__PB_EC['CONFIG']=2
__PB_EC['NEXISTS']=3
__PB_EC['CMD']=4
__PB_EC['INTERNAL']=255

[[ -v PMODULES_HOME ]] && \
	std::die ${__PB_EC['CMD']} \
		 "%s " \
		 "This version of modbuild cannot be used with the modulecmd from Pmodules!"

source "${prefix}/lib/libpmodules.bash"  || \
        std::die ${__PB_EC['INTERNAL']} "Oops: cannot source library -- '$_'"
source "${prefix}/lib/libpbuild.bash"    || \
        std::die ${__PB_EC['INTERNAL']} "Oops: cannot source library -- '$_'"
unset prefix

# these variables must be exported for envsubst(1)
declare -x P=''
declare -x V=''
declare -x V_PKG=''
declare -x V_MAJOR=''           # first number in version string
declare -x V_MINOR=''           # second number in version string (or empty)
declare -x V_PATCHLVL=''        # third number in version string (or empty)
declare -x V_RELEASE=''         # module release (or empty)
declare -x PREFIX=''
declare -x SRC_DIR=''
declare -x BUILD_DIR=''

##############################################################################
#
usage() {
        std::error "
USAGE:
        $0 [options...] version
        or
        modbuild BUILD_SCRIPT [options...] version

MANDATORY ARGUMENTS:

version
        Version of module to build.

SELECT VARIANT TO BUILD:

--system
        Specify the system for selecting variants. Defaults to the
        OS version and release like 'rhel6'.

--with=P/V
        Select compiler, MPI implementation and/or HDF5 version to be
        used to compile the module. Use multiple '--with' arguments to
        disambiguate the selected variant.


--variant=VARIANT
        With this option a specific variant to build can be specified.

BUILD-STEPS OPTIONS:

--clean-install
        Remove module if already exists before building.

--prep
        Prepare sources: unpack sources and apply patches only.

--configure
        Prepare and configure sources.

--compile
        Prepare, configure and compile everything.

--install
        Prepare, configure and compile everything. Finally run install
        step. Do not clean up build and source directory.

--all
        Run through all steps including cleanup.

--update-modulefiles
        Install only the modulefile and set the release stage.

--update-relstage
        Update the release stage.

--skip-subpkgs
        Don't (re-)build sub-packages.

--cleanup-modulefiles
        Remove modulefiles in other overlays.

MISCELLANEOUS OPTIONS:

-? | -h | --help
        Print usage.

-V | --version
        Print version.

-v | --verbose
        Verbose output.

--debug
        Run in debug mode.

-j N | --jobs=N
        Run N parallel make jobs.

-f | --force-rebuild
        Force rebuild of module.

--config-file=FILE
        Use this config file instead of the default.

--disable-cleanup-build
--disable-cleanup-src
--disable-cleanup
        Disable cleanup of files in the build and/or source
        directories. By default, all files in the build and
        source directories are removed at the start of a
        build and after a successful build.

--distdir=DIR
        Directory where downloaded files are stored and
        looked up.

--tmpdir=DIR
        Directory used for building modules.

--exit-on-error
        Set \"exit on error\" option in Bash. This option should
        be used by modbuild developers only.

DOCUMENTATION:
        Full documentation is available at
        https://pmodules.github.io
"
        exit 1
}

##############################################################################
#
# parse options and arguments
#

# used in some build-recipes, hence we have to export it!
declare -x      JOBS=0

declare -A      BuildOpts=()
BuildOpts['force_rebuild']='no'
BuildOpts['cleanup_build']='yes'
BuildOpts['cleanup_src']='yes'
BuildOpts['update_relstage']='no'
BuildOpts['update_modulefiles']='no'
BuildOpts['cleanup_modulefiles']='no'
BuildOpts['build_target']='all'
BuildOpts['clean_install']='no'
BuildOpts['num_jobs']=0
BuildOpts['verbose']=0
BuildOpts['debug']='no'
BuildOpts['prefix']=''
BuildOpts['is_subpkg']='no'
BuildOpts['skip_subpkgs']='no'
BuildOpts['config_file']=''

# versions to be built, '.*' or none means all
declare -a      versions_to_build=()
declare         opt_system=''
declare -a      opt_with_modules=()
declare -A      opt_with_dict=()
declare --      opt_config_file=''
declare --      opt_variant=''

declare --      BUILD_SCRIPT=''
declare --      module_name=''

parse_args() {
        #
        # The first argument ($1) is the build-script, if called in the
        # usual way:
        #     ./<build-script> <version> [options]
        # If called via:
        #     modbuild <build-script> [options]
        # the build-script MUST be passed as first argument.
        #
        (( $# == 0 )) && usage
        while (( $# > 0 )); do
                local option=''
                case $1 in
                        -j | --jobs=*)
                                local -- val=''
                                option="$1"
                                if [[ $1 == *=* ]]; then
                                        val="${1#--*=}"
                                elif (( $# >= 2 )); then
                                        val="$2"
                                        shift
                                fi
                                [[ -n "${val}" ]] || \
                                        std::die 1 "Option '${option}': missing value"
                                [[ "${val}" =~ ^[0-9]+$ ]] || \
                                        std::die 1 "Invalid jobs value: ${val}"
                                BuildOpts['num_jobs']="${val}"
                                shift
                                ;;
                        -v | --verbose )
                                trap 'echo "$BASH_COMMAND"' DEBUG
                                (( BuildOpts['verbose']+=1 ))
                                ;;
                        --debug )
                                BuildOpts['debug']='yes'
                                set -x
                                ;;
                        -f | --force-rebuild )
                                BuildOpts['force_rebuild']='yes'
                                ;;
                        -\? | -h | --help )
                                usage
                                ;;
                        -V | --version )
                                std::die 0  "\nmodbuild version ${VERSION}\nCopyright GNU GPL v2\n"
                                ;;
                        --disable-cleanup )
                                BuildOpts['cleanup_build']='no'
                                BuildOpts['cleanup_src']='no'
                                ;;
                        --disable-cleanup-build )
                                BuildOpts['cleanup_build']='no'
                                ;;
                        --disable-cleanup-src )
                                BuildOpts['cleanup_src']='no'
                                ;;
                        --distdir | --distdir=* )
                                option="$1"
                                PMODULES_DISTFILESDIR=''
                                if [[ $1 == *=* ]]; then
                                        PMODULES_DISTFILESDIR="${1#--*=}"
                                elif (( $# >= 2 )); then
                                        PMODULES_DISTFILESDIR="$2"
                                        shift
                                fi
                                [[ -n "${PMODULES_DISTFILESDIR}" ]] || \
                                        std::die 1 "Option '${option}': missing value"
                                ;;
                        --exit-on-error )
                                # this is for testing!
                                set -e
                                ;;
                        --tmpdir | --tmpdir=* )
                                option="$1"
                                PMODULES_TMPDIR=''
                                if [[ $1 == *=* ]]; then
                                        PMODULES_TMPDIR="${1#--*=}"
                                elif (( $# >= 2 )); then
                                        PMODULES_TMPDIR="$2"
                                        shift
                                fi
                                [[ -n "${PMODULES_TMPDIR}" ]] || \
                                        std::die 1 "Option '${option}': missing value"
                                ;;
                        --system | --system=* )
                                option="$1"
                                opt_system=''
                                if [[ $1 == *=* ]]; then
                                        opt_system="${1#--*=}"
                                elif (( $# >= 2 )); then
                                        opt_system="$2"
                                        shift
                                fi
                                [[ -n "${opt_system}" ]] || \
                                        std::die 1 "Option '${option}': missing value"
                                ;;
                        --with | --with=* )
                                option="$1"
                                local -- with=''
                                if [[ $1 == *=* ]]; then
                                        with="${1#--*=}"
                                elif (( $# >= 2 )); then
                                        with="$2"
                                        shift
                                fi
                                [[ -n "${with}" ]] || \
                                        std::die 1 "Option '${option}': missing value"
                                opt_with_modules+=( "${with}" )
                                opt_with_dict[${with}]=0
                                ;;
                        --prep | --configure | --compile | --install | --all )
                                BuildOpts['build_target']=${1:2}
                                ;;
                        --clean-install )
                                BuildOpts['force_rebuild']='yes'
                                BuildOpts['clean_install']='yes'
                                ;;
                        --update-relstage )
                                BuildOpts['update_relstage']='yes'
                                ;;
                        --update-modulefiles )
                                BuildOpts['update_modulefiles']='yes'
                                ;;
                        --skip-subpkgs )
                                BuildOpts['skip_subpkgs']='yes'
                                ;;
                        --cleanup-modulefiles )
                                BuildOpts['cleanup_modulefiles']='yes'
                                ;;
                        --config-file | --config-file=* )
                                option="$1"
                                opt_config_file=''
                                if [[ $1 == *=* ]]; then
                                        opt_config_file="${1#--*=}"
                                elif (( $# >= 2 )); then
                                        opt_config_file="$2"
                                        shift
                                fi
                                [[ -n "${opt_config_file}" ]] || \
                                        std::die 1 "Option '${option}': missing value"
                                ;;
                        --variant | --variant=* )
                                option="$1"
                                opt_variant=''
                                if [[ $1 == *=* ]]; then
                                        opt_variant="${1#--*=}"
                                elif (( $# >= 2 )); then
                                        opt_variant="$2"
                                        shift
                                fi
                                [[ -n "${opt_variant}" ]] || \
                                        std::die 1 "Option '${option}': missing value"
                                ;;
                        --parent-prefix | --parent-prefix=* )
                                option="$1"
                                BuildOpts['prefix']=''
                                if [[ $1 == *=* ]]; then
                                        BuildOpts['prefix']="${1#--*=}"
                                elif (( $# >= 2 )); then
                                        BuildOpts['prefix']="$2"
                                        shift
                                fi
                                [[ -n "${BuildOpts['prefix']}" ]] || \
                                        std::die 1 "Option '${option}': missing value"
                                BuildOpts['is_subpkg']='yes'
                                ;;
                        -- | '' )
                                :
                                ;;
                        -* )
                                std::die 1 "Invalid option -- '$1'"
                                ;;
                        * )
                                local -- arg="$1"
                                if [[ -f "${arg}" && -x "${arg}" ]]; then
                                        BUILD_SCRIPT="$(std::get_abspath "${arg}")"
                                        BUILDBLOCK_DIR=$(dirname "${BUILD_SCRIPT}")
                                elif [[ "${arg}" == */* ]]; then
                                        module_name="${arg%/*}"
                                        versions_to_build+=( "${arg#*/}" )
                                else
                                        versions_to_build+=( "$1" )
                                fi
                                ;;
                esac
                shift
        done

        [[ -z "${BUILD_SCRIPT}" ]] && \
                std::die 1 "%s " \
                         "Build script argument missing!"

        # if no version is specified on the cmd-line, build all versions
        (( ${#versions_to_build[@]} > 0)) || versions_to_build+=( '.*' )

        # set system if not set on the cmd-line
        opt_system="${opt_system:-$(std::get_os_release)}"

        if (( ${BuildOpts['num_jobs']} == 0 )); then
                BuildOpts['num_jobs']=$(std::get_num_cores)
                (( BuildOpts['num_jobs'] > 10 )) && BuildOpts['num_jobs']=10 || :
        fi
        JOBS="${BuildOpts[num_jobs]}"
        # set config file
        local -r config_file="${opt_config_file:-${BUILDBLOCK_DIR}/files/config.yaml}"
        [[ -f "${config_file}" && -r "${config_file}" ]] || \
                std::die 2 \
                         "%s -- %s" \
                         "YAML config file doesn't exist or is not readable" \
                         "${config_file}"
        BuildOpts['config_file']="${config_file}"
        std::info "Using YAML configuration file - ${config_file}"
}

##
## cfg::get_file_fmt - get file format of configuration file
##
## The format defaults to 1 if not defined in the configuration file.
## For now, this is the only supported format.
##
## Arguments:
##   $1 - [out] return format in this reference variable
##   $2 - [in] YAML string
##
cfg::get_file_fmt(){
        local -n yml_fmt="$1"
        local -n yml_content="$2"

        if yml::has_key yml_content 'format'; then
                yml::get_value yml_fmt yml_content '.format' '!!int'
        else
                yml_fmt='1'
        fi
        case "${yml_fmt}" in
                1 )
                        :
                        ;;
                * )
                        std::die 3 \
                                 "%s" \
                                 "Unsupported YAML configuration file format -- ${yml_fmt}"
                        ;;
        esac
}

declare -A Yaml_default_config=(
        ['name']=''
        ['version']=''
        ['build_requires']=''           # !!seq of strings
        ['build_functions']=''          # !!seq of strings
        ['build_variants']=''           # !!seq of strings
        ['compile_in_sourcetree']='no'  # !!str
        ['configure_args']=''           # !!seq of strings
        ['configure_args+']=''          # !!seq of strings
        ['configure_with']='auto'       # !!str
        ['default_variant']=''          # !!str
        ['docfiles']=''                 # !!seq of strings
        ['docfiles+']=''                # !!seq of strings
        ['download_dir']=''             # !!str
        ['group']='Tools'               # !!str
        ['group_deps']=''               # !!map
        ['kernels']=''                  # !!seq of strings
        ['modulefile']=''               # !!str
        ['overlay']='base'              # !!str
        ['patch_files']=''              # !!seq of strings
        ['patch_files+']=''             # !!seq of strings
        ['relstage']='unstable'         # !!str
        ['runtime_deps']=''             # !!seq of strings
        ['sub_packages']=''             # !!seq
        ['suffix']=''                   # !!str
        ['systems']=''                  # !!seq of strings
        ['target_cpus']=''              # !!seq of strings
        ['urls']=''                     # !!seq
        ['sources']=''                  # !!seq; alias for urls
        ['use_flags']=''                # !!seq of strings
        ['use_overlays']=''             # !!seq of strings
        ['variant']=''                  # !!str
        ['target_funcs:prep']='pbuild::pre_prep pbuild::prep pbuild::post_prep'
        ['target_funcs:configure']='pbuild::pre_configure pbuild::configure pbuild::post_configure'
        ['target_funcs:compile']='pbuild::pre_compile pbuild::compile pbuild::post_compile'
        ['target_funcs:install']='pbuild::pre_install pbuild::install pbuild::post_install'
        ['group_deps:compiler']=''
        ['group_deps:mpi']=''
        ['group_deps:hdf5']=''
        ['group_deps:hdf5_serial']=''
        ['group_deps:yaml']=''
        ['num_sources']=0
)

declare -A Yaml_source_keys=(
        ['url']=''
        ['name']=''
        ['strip_dirs']=1
        ['unpacker']='tar'
        ['unpack_dir']=''
        ['patch_file']=''
        ['patch_strip']=0
)

declare -A Unpackers=(
        ['tar']='tar'
        ['7z']='7z'
        ['none']='none'
)

declare -A KernelNames=(
        ['linux']='1'
        ['darwin']='1'
        ['any']='1'
)

declare -A TargetCPUs=(
        ['x86_64']=1
        ['arm64']=1
        ['aarch64']=1
        ['any']='1'
)

declare -A hierarchical_groups=(
        ['compiler']='compiler'
        ['mpi']='compiler mpi'
        ['hdf5']='compiler mpi hdf5'
        ['hdf5_serial']='compiler hdf5_serial'
)

cfg::err_missing_group_dependencies(){
        local -n __cfg="$1"
        local -r name="${__cfg['name']}/${__cfg['version']:-${__cfg['version_pattern']}}"
        std::die 2 "%s " \
                 "${name}:" \
                 "Error: missing group dependency for module in group '${__cfg['group']}' -" \
                 "$2"
}

cfg::err_invalid_group_dependency(){
        local -n __cfg="$1"
        local -r name="${__cfg['name']}/${__cfg['version']:-${__cfg['version_pattern']}}"
        std::die ${__PB_EC['CMD']} "%s " \
                 "${name}:" \
                 "Error: invalid group dependency for module in group '${__cfg['group']}' -" \
                 "$2"
}

cfg::err_invalid_variants_block(){
        local -n __cfg="$1"
        local -r name="${__cfg['name']}/${__cfg['version']:-${__cfg['version_pattern']}}"
        std::die ${__PB_EC['CMD']} "%s " \
                 "${name}:" \
                 "Error: invalid type of variants block: must be '!!seq' but is - '$2'!"
}

cfg::err_invalid_value(){
        local -n __cfg="$1"
        local -r name="${__cfg['name']}/${__cfg['version']:-${__cfg['version_pattern']}}"
        std::die ${__PB_EC['CMD']} "%s " \
                 "${name}:" \
                 "Error: invalid value for key '$3' in $2 - '$4'"
}

cfg::err_invalid_key(){
        local -n __cfg="$1"
        local -r str="$2"
        shift 2
        local -r name="${__cfg['name']}/${__cfg['version']:-${__cfg['version_pattern']}}"
        std::die ${__PB_EC['CMD']} "%s " \
                 "${name}:" \
                 "Error: invalid key(s) in ${str} -" "$@"
}

cfg::err_wrong_module_type(){
        local -n __cfg="$1"
        local -r name="${__cfg['name']}/${__cfg['version']:-${__cfg['version_pattern']}}"
        std::die ${__PB_EC['CMD']} "%s " \
                 "${name}:" \
                 "Module type is '$2' but was called as - '$3'!"
}

cfg::err_invalid_module_type(){
        local -n __cfg="$1"
        local -r name="${__cfg['name']}/${__cfg['version']:-${__cfg['version_pattern']}}"
        std::die ${__PB_EC['CMD']} "%s " \
                 "${name}:" \
                 "Invalid module type - '$2'"
}

cfg::err_undef_group(){
        local -n __cfg="$1"
        local -r name="${__cfg['name']}/${__cfg['version']:-${__cfg['version_pattern']}}"
        std::die ${__PB_EC['CMD']} "%s " \
                 "${name}:" \
                 "Error: group must be defined before group dependencies!"
}

cfg::err_group_not_hierarchical(){
        local -n __cfg="$1"
        local -r name="${__cfg['name']}/${__cfg['version']:-${__cfg['version_pattern']}}"
        std::die ${__PB_EC['CMD']} "%s " \
                 "${name}:" \
                 "Error: group dependencies defined for non-hierarchical group '${__cfg['group']}'!"
}

cfg::err_ctrl_char_in_version_key(){
        local -n __cfg="$1"
        local -r name="${__cfg['name']}/${__cfg['version']:-${__cfg['version_pattern']}}"
        std::die ${__PB_EC['CMD']} "%s " \
		 "Control characters in version keys are forbidden!"
}

##
## cfg::parse_group_deps - parse group dependencies
##
## Parse the YAML formatted group dependencies and store them in the
## module configuration structure.
##
## Arguments:
##   $1 - reference to dictionary with module configuration
##
## Used global variables:
##   opt_with_dict
##
cfg::parse_group_deps(){
        local -n _cfg="$1"
        local -r _input_yml="${_cfg['group_deps:yaml']}"

        local -- mod_group="${_cfg['group']}"

        [[ -n "${mod_group}" ]] || \
                cfg::err_undef_group '_cfg'
        [[ -v hierarchical_groups[${mod_group,,}] ]] || \
                cfg::err_group_not_hierarchical '_cfg'
        # get specified group dependencies
        local -- group=''
        local -a groups=()
        yml::get_keys groups _input_yml '.'
        for group in "${groups[@]}"; do
                # is ${group} a hierarchical group name?
                [[ -v hierarchical_groups[${group,,}] ]] || \
                        cfg::err_invalid_group_dependency '_cfg' "${group}"

                # is this in the list of required group dependencies?
                std::array::contains "${group,,}" \
                                     ${hierarchical_groups[${mod_group,,}]} || \
                        cfg::err_invalid_group_dependency '_cfg' "${group}"
                local -- key
                local -a keys=()
                local -a with_modules=()
                local -a modules=()
                yml::get_keys keys _input_yml ".${group}"
                for key in "${keys[@]}"; do
                        local -- version=''
                        local -a versions=()
                        local -- value=''
                        yml::get_seq value _input_yml ".${group}.${key}" || \
                                yml::die_parsing "${_input_yml}"
                        readarray -t versions <<<"${value}"
                        modules+=( "${versions[@]/#/${key}/}" )
                        for version in "${versions[@]}"; do
                                # use only dependencies specified on the cmd-line!
                                if [[ -v opt_with_dict[${key}/${version}] ]]; then
                                        with_modules+=( "${key}/${version}" )
                                fi
                        done
                done
                # For this hierarchical group nothing has been specified on the
                # cmd-line.
                # All group dependencies listed in the YAML file will be used.
                if (( ${#with_modules[@]} == 0 )); then
                        with_modules=( "${modules[@]}" )
                fi
                local -- str
                printf -v  str "%s\n" "${with_modules[@]}"
                _cfg[group_deps:${group,,}]="${str:0:-1}"
        done
        # are all required hierarchical  dependencies defined?
        for group in ${hierarchical_groups[${mod_group,,}]}; do
                [[ -n "${_cfg[group_deps:${group,,}]}" ]] || \
                        cfg::err_missing_group_dependencies '_cfg' "${group}"
        done

}

##
## cfg::get_config - get settings from a variant configuration structure
##
## Arguments:
##   $1 - [in] reference to YAML formatted string
##   $2 - [in] key of variant configuration
##   $3 - [out] reference to Bash dictionary
##
cfg::get_config(){
        local -n yml_input="$1"
        local -- cfg_key="$2"
        local -n cfg="$3"

        local -- key=''
        local -- value=''

        get_build_functions(){
                local -a keys=()
                yml::get_keys \
                        keys \
                        yml_input \
                        "${cfg_key}.build_functions"

                local -- key=''
                local -- value=''
                for key in "${keys[@]}"; do
                        case ${key} in
                                prep | configure | compile | install)
                                        yml::get_seq \
                                                value \
                                                yml_input \
                                                "${cfg_key}.build_functions.${key}" || \
                                                yml::die_parsing "${yml_input}"
                                        cfg[target_funcs:${key}]="${value}"
                                        ;;
                                * )
                                        cfg::err_invalid_key 'cfg' 'build_functions' "${key}"
                                        ;;
                        esac
                done
        }

        if [[ -z "${yml_input}" ]]; then
                return 0
        fi

        local -a keys=()
        yml::get_keys keys yml_input "${cfg_key}"
        for key in "${keys[@]}"; do
                case ${key} in
                        build_functions )
                                get_build_functions value
                                ;;
                        build_variants )
                                yml::get_value \
                                        value \
                                        yml_input \
                                        "${cfg_key}.${key}" '!!str'
                                case ${value,,} in
                                        all ) : ;;
                                        first_match ) : ;;
                                        * )
                                                cfg::err_invalid_value \
                                                        'cfg' \
                                                        'config section' \
                                                        "${key}" \
                                                        "${value}"
                                                ;;
                                esac
                                cfg[${key,,}]="${value}"
                                ;;
                        compile_in_sourcetree )
                                yml::get_value \
                                        value \
                                        yml_input \
                                        "${cfg_key}.${key}" '!!bool'
                                case ${value,,} in
                                        true )
                                                cfg[${key,,}]='yes'
                                                ;;
                                        false )
                                                cfg[${key,,}]='no'
                                                ;;
                                        * )
                                                cfg::err_invalid_value \
                                                        'cfg' \
                                                        'config section' \
                                                        "${key}" \
                                                        "${value}"
                                                ;;
                                esac
                                ;;
                        configure_with )
                                yml::get_value \
                                        value \
                                        yml_input \
                                        "${cfg_key}.${key}" '!!str'
                                case ${value,,} in
                                        auto | cmake | autotools )
                                                cfg[${key,,}]="${value,,}"
                                                ;;
                                        * )
                                                cfg::err_invalid_value \
                                                        'cfg' \
                                                        'config section' \
                                                        "${key}" \
                                                        "${value}"
                                                ;;
                                esac
                                ;;
                        default_variant | download_dir | group | modulefile \
                                | suffix )
                                yml::get_value \
                                        value \
                                        yml_input \
                                        "${cfg_key}.${key}" '!!str'
                                cfg[${key,,}]="${value}"
                                ;;
                        overlay )
                                yml::get_value \
                                        value \
                                        yml_input \
                                        "${cfg_key}.${key}" '!!str'
                                cfg[${key,,}]="${value}"
                                ;;
                        group_deps )
                                yml::get_value \
                                        value \
                                        yml_input \
                                        "${cfg_key}.${key}" '!!map'
                                cfg['group_deps:yaml']="${value}"
                                ;;
                        use_flags )
                                yml::get_seq \
                                        value \
                                        yml_input \
                                        "${cfg_key}.${key}" || \
                                        yml::die_parsing "${yml_input}"
                                local -a tmp=()
                                readarray -t tmp <<<"${value}"
                                cfg[${key,,}]=" ${tmp[*]} "
                                ;;
                        relstage )
                                yml::get_value \
                                        value \
                                        yml_input \
                                        "${cfg_key}.${key}" '!!str'
                                case ${value,,} in
                                        unstable | stable | deprecated )
                                                cfg[${key,,}]="${value,,}"
                                                ;;
                                        remove | removed )
                                                cfg[${key,,}]='remove'
                                                ;;
                                        * )
                                                cfg::err_invalid_value \
                                                        'cfg' \
                                                        'config section' \
                                                        "${key}" \
                                                        "${value}"
                                                ;;
                                esac
                                ;;
                        sub_packages )
                                yml::get_value \
                                        value \
                                        yml_input \
                                        "${cfg_key}.${key}" '!!seq'
                                cfg[${key,,}]="${value}"
                                ;;
                        urls | sources )
                                yml::get_value \
                                        value \
                                        yml_input \
                                        "${cfg_key}.${key}" '!!seq'
                                cfg::parse_urls 'set' "${value}" cfg
                                ;;
                        urls+ | sources+ )
                                yml::get_value \
                                        value \
                                        yml_input \
                                        "${cfg_key}.${key}" '!!seq'
                                cfg::parse_urls 'add' "${value}" cfg
                                ;;
                        build_requires | configure_args | docfiles | patch_files \
                                | runtime_deps | systems | use_overlays | variant )
                                yml::get_seq \
                                        value \
                                        yml_input \
                                        "${cfg_key}.${key}" || \
                                        yml::die_parsing "${yml_input}"
                                cfg[${key,,}]="${value}"
                                ;;
                        kernels )
                                yml::get_seq \
                                        value \
                                        yml_input \
                                        "${cfg_key}.${key}" || \
                                        yml::die_parsing "${yml_input}"
                                local -a items=()
                                readarray -t items <<< "${value,,}"
                                local -- item=''
                                for item in "${items[@]}"; do
                                        [[ -v KernelNames[${item}] ]] || \
                                                cfg::err_invalid_value \
                                                        'cfg' \
                                                        'config section' \
                                                        'kernel' \
                                                        "${item}"
                                done
                                cfg[${key,,}]="${value}"
                                ;;
                        target_cpus )
                                yml::get_seq \
                                        value \
                                        yml_input \
                                        "${cfg_key}.${key}" || \
                                        yml::die_parsing "${yml_input}"
                                local -a items=()
                                readarray -t items <<< "${value,,}"
                                local -- item=''
                                for item in "${items[@]}"; do
                                        [[ -v TargetCPUs[${item}] ]] || \
                                                cfg::err_invalid_value \
                                                        'cfg' \
                                                        'config section' \
                                                        'CPU' \
                                                        "${item}"
                                done
                                cfg[${key,,}]="${value}"
                                ;;
                        'configure_args+' | 'docfiles+' | 'patch_files+' )
                                yml::get_seq \
                                        value \
                                        yml_input \
                                        "${cfg_key}.${key}" || \
                                        yml::die_parsing "${yml_input}"
                                key="${key:0:-1}"
                                if [[ -z "${cfg[${key,,}]}" ]]; then
                                        cfg[${key,,}]="${value}"
                                else
                                        cfg[${key,,}]+=$'\n'"${value}"
                                fi
                                ;;

                        * )
                                cfg::err_invalid_key 'cfg' 'config section' "${key}"
                                ;;
                esac
        done
}

cfg::check_config(){
	local -n __cc_cfg="$1"
	local -- __cc_ol="${__cc_cfg['overlay']}"
        [[ -v OverlayInfo[${__cc_ol}:install_root] ]] || \
                std::die 2 "%s" \
                         "Overlay doesn't exist - ${__cc_ol}"

	[[ -n "${__cc_cfg['group_deps:yaml']}" ]] && cfg::parse_group_deps __cc_cfg
}

##
## cfg::parse_urls - read sources/urls
##
## Arguments:
##   $1 - mode: set or add
##   $2 - sources/urls in YAML format
##   $3 - reference to a dictionary holding the configuration
##
cfg::parse_urls(){
        local -r mode="$1"
        local -- yaml="$2"
        local -n _cfg="$3"

        # this query is used in the for loop below
        local -r str=$(printf '.%s, ' "${!Yaml_source_keys[@]}")
        local -r query="[${str%, }] | @tsv"

        local -i i=0 len=0 n=0
        yml::get_seq_length len yaml .
        [[ "${mode}" == 'add' ]] && n=${_cfg['num_sources']}
        for ((i=0; i<len; i++, n++)); do
                local -- url_yaml=''
                url_yaml=$(yq -Ne ".[$i]" <<<"${yaml}")

                local -a keys=()
                yml::get_keys keys url_yaml '.'

                # are all keys valid?
                local -a diff=()
                local -a valid_keys=( "${!Yaml_source_keys[@]}" )
                std::array::difference diff keys valid_keys
                (( ${#diff[@]} == 0 )) || \
                        cfg::err_invalid_key \
                                '_cfg' \
                                'list of sources/URLs' \
                                "${diff[@]}"

                # initialize n-th source in module config
                # and loop over all key
                std::dict::merge _cfg Yaml_source_keys ":$n"
                local key='' value=''
                for key in "${keys[@]}"; do
                        local -- __pu_type='!!str'
                        case ${key} in
                                patch_strip | strip_dirs)
                                        __pu_type='!!int'
                                        ;;
                        esac
                        yml::get_value 'value' 'url_yaml' ".${key}" "${__pu_type}"

                        case ${key} in
                                patch_strip | strip_dirs)
                                        [[ ${value} =~ ^[0-9]+$ ]] || \
                                                cfg::err_invalid_value \
                                                        '_cfg' \
                                                        'list of URLs/sources' \
                                                        "${key}" "${value}"
                                        _cfg[${key}:$n]="${value}"
                                        ;;
                                unpacker)
                                        [[ -v Unpackers[${value,,}] ]] || \
                                                cfg::err_invalid_value \
                                                        '_cfg' \
                                                        'list of URLs/sources' \
                                                        "${key}" "${value}"
                                        _cfg[${key}:$n]=${value,,}
                                        ;;
                                *)
                                        _cfg[${key}:$n]="${value}"
                                        ;;
                        esac
                done
        done
        _cfg['num_sources']="${n}"
}

##
## cfg::is_variant_to_build - do we have to build this variant?
##
## Arguments:
##   $1 - reference to configuration
##
## Returns:
##   0 - yes, we have to build this variant
##   1 - no
##
## Used global variables:
##   opt_system
##
cfg::is_variant_to_build(){
        local -n config="$1"
        local -- name="${config['name']}"
        local -- version="${config['version']}"

        check_system(){
                [[ -z ${config['systems']} ]] && return 0
                local -a systems=()
                readarray -t systems <<< "${config['systems'],,}"
                local -- hostname
                hostname=$(hostname -f)
                local -- system
                for system in "${systems[@]}"; do
                        [[ "${opt_system,,}" =~ ${system} ]] && return 0
                        [[ "${hostname,,}" =~ ${system} ]] && return 0
                done
                std::info "%s " "Skipping variant '${version}'" \
                          "for the system(s): ${systems[*]}"
                return 1
        }

        check_kernel(){
                [[ -z ${config['kernels']} ]] && return 0
                local -a kernels=()
                readarray -t kernels <<< "${config['kernels'],,}"
                local -- kernel=''
                local -- kernel_name
                kernel_name=$(std::get_kernel_name)
                for kernel in "${kernels[@]}"; do
                        [[ ${kernel,,} == 'any' ]] && return 0
                        [[ ${kernel_name,,} =~ ${kernel,,} ]] && return 0
                done
                std::info "%s " "Skipping variant '${version}'" \
                          "for the kernel(s): ${config['kernels']}"
                return 1
        }

        check_target_cpu(){
                [[ -z ${config['target_cpus']} ]] && return 0
                local -a target_cpus=()
                readarray -t target_cpus <<< "${config['target_cpus'],,}"
                local -- system_cpu
                system_cpu=$(std::get_system_cpu)
                local -- cpu=''
                for cpu in "${target_cpus[@]}"; do
                        [[ ${cpu,,} == 'any' ]] && return 0
                        [[ "${system_cpu,,}" == "${cpu,,}" ]] && return 0
                done
                std::info "%s " "Skipping variant '${version}'" \
                          "for the CPU(s) ${config['target_cpus']}"
                return 1

        }

        check_variant(){
                # If no variant is passed as an argument and no default
                # is defined, build this variant.
                local -- build_variant="${opt_variant:-${config['default_variant']}}"
                [[ -z "${build_variant}" ]] && return 0

                # Don't build if a variant has been specified on the
                # command line (or a default variant is set in the
                # config) but no variant name is defined in the
                # configuration of this variant.
                # Note: ${build_variant} != ''!
                [[ -z ${config['variant']} ]] && return 1

                local -a items=()
                readarray -t items <<< "${config['variant'],,}"
                local item=''
                for item in "${items[@]}"; do
                        [[ "${build_variant}" == "${item}" ]] && return 0
                done
                return 1
        }

        check_kernel     || return 1
        check_target_cpu || return 1
        check_system     || return 1
        check_variant    || return 1
        return 0
}

##
## cfg::parse_version - parse the given version number
##
## A version number must have the following form:
##   x.y.z-r_suffix
## whereby x, y, z and r are unsigned integers and the suffix is an arbitrary string.
## In the function we set the following global variables:
##   V=x.y.z-r_suffix
##   V_PKG=x.y.z
##   V_MAJOR=x
##   V_MINOR=y
##   V_PATCHLVL=z
##   V_RELEASE=r
##
## Arguments:
##   $1 - the version number
##
cfg::parse_version() {
        local -- v="$1"
        V="$1"
        V_MAJOR=''
        V_MINOR=''
        V_PATCHLVL=''
        V_RELEASE=''

        [[ "$v" =~ "_" ]] && v="${v%%_*}"
        V_PKG="${v%%-*}"                # version without the release number
        if [[ $v == *-* ]]; then
                V_RELEASE="${v#*-}"     # release number
        fi
        local -- tmp=''
        case "${V_PKG}" in
                *.*.* )
                        V_MAJOR="${V_PKG%%.*}"
                        tmp="${V_PKG#*.}"
                        V_MINOR="${tmp%%.*}"
                        V_PATCHLVL="${tmp#*.}"
                        ;;
                *.* )
                        V_MAJOR="${V_PKG%.*}"
                        V_MINOR="${V_PKG#*.}"
                        ;;
                * )
                        V_MAJOR="${V_PKG}"
                        ;;
        esac
}

##
## cfg::expand_version_key - expand a version key
##
## Return list of matching version in a given version key. A version key is a
## semicolon-separated list of version specifications like:
##
##  42.0.{0..5};41.0.{0..3}
##
## Brace expansion has to be performed on each version specification in the list.
##
## Arguments:
##   $1 - reference variable to return result
##   $2 - version key used in YAML configuration file
##   $3 - regex
##
cfg::expand_version_key(){
        local -n ev_result="$1"
        local -- key="$2"
        local -- version="$3"

        ev_result=()
        # loop over semicolon separated list of keys
        local -- k
        for k in ${key//;/ }; do
		[[ "$k" =~ [[:cntrl:]] ]] && \
			cfg::err_ctrl_char_in_version_key
                local -a list=()
                readarray -t list < <(std::expand_braces "${k}")
                local -- l
                for l in "${list[@]}"; do
                        if [[ $l =~ ^${version}$ ]]; then
                                ev_result+=("${l}")
                        fi
                done
        done
}

##
## cfg::get_matching_version_keys(){
##
## Return list of version keys matching a given pattern. The input is the
## corresponding '.version' node of the YAML configuration file.
##
## Arguments:
##   $1 - [in] YAML text
##   $2 - [out] list of matching version keys
##   $3 - [in] regex pattern (not glob!)
##
cfg::get_matching_version_keys(){
        local -n yaml_input="$1"
        local -n result="$2"
        local -- version="$3"

        local -a keys=()
        yml::get_keys keys yaml_input '.versions'
        result=()
        local -- key k
        for key in "${keys[@]}"; do
                # loop over semicolon separated list of keys
                for k in ${key//;/ }; do
                        local -a list=()
			[[ "$k" =~ [[:cntrl:]] ]] && \
				cfg::err_ctrl_char_in_version_key
                        readarray -t list < <(std::expand_braces "${k}")
                        local -- l=''
                        for l in "${list[@]}"; do
                                if [[ ${l} =~ ^${version}$ ]]; then
                                        result+=("${key}")
                                        break
                                fi
                        done
                done
        done
        (( ${#result[@]} == 0 )) && \
                std::die 3 "%s" "No configuration for version -- ${version}"
        return 0
}

##
## build::modules_compiler - build modules in the compiler hierarchy
## build::modules_hdf5_serial - build modules in the serial HDF5 hierarchy
## build::modules_hdf5 - build modules in the parallel HDF5 hierarchy
## build::modules_mpi - build modules in the MPI hierarchy
## build::modules_other - build all other modules
##
## To compile a module with a certain compiler||mpi||hdf5 dependency
## the '--with' option can be used. Depending on the hierarchical
## group the modules specified with the option '--with' must be a
## subset of
## - compiler: ( compiler )
## - mpi: ( compiler mpi )
## - hdf5: ( compiler mpi hdf5 )
## - hdf5_serial: ( compiler hdf5_serial )
##
## Arguments:
##   $1 - module configuration
##   $2 - structure with command-line arguments
##
build::modules_compiler(){
        local -n _cfg="$1"

        local -a with_compiler=()
        readarray -t with_compiler <<<"${_cfg['group_deps:compiler']}"

        local -- compiler=''
        for compiler in "${with_compiler[@]}"; do
                # build if opt_with_modules is empty or compiler is in this array
                if (( ${#opt_with_modules[@]} != 0 )); then
                        if ! std::array::is_subset \
                             opt_with_modules \
                             "${compiler}"; then
                                std::info "%s " \
                                          "Skipping build with" \
                                          "${compiler}"
                                continue
                        fi
                fi
                pbcore::build \
                        "$1" \
                        "$2" \
                        "${compiler}"
        done
}

build::modules_hdf5_serial(){
        local -n _cfg="$1"

        local -a with_compiler=()
        local -a with_hdf5_serial=()
        readarray -t with_compiler <<<"${_cfg['group_deps:compiler']}"
        readarray -t with_hdf5_serial <<<"${_cfg['group_deps:hdf5_serial']}"

        local -- compiler
        local -- hdf5_serial
        for compiler in "${with_compiler[@]}"; do
                for hdf5_serial in "${with_hdf5_serial[@]}"; do
                        # build if opt_with_modules is empty or compiler is in this array
                        if (( ${#opt_with_modules[@]} != 0 )); then
                                if ! std::array::is_subset \
                                     opt_with_modules \
                                     "${compiler}" "${hdf5_serial}"; then
                                        std::info "%s " \
                                                  "Skipping build with" \
                                                  "'${hdf5_serial}'"
                                        continue
                                fi
                        fi
                        pbcore::build \
                                "$1" \
                                "$2" \
                                "${compiler}" \
                                "${hdf5_serial}"
                done
        done
}

build::modules_mpi(){
        local -n _cfg="$1"

        local -a with_compiler=()
        local -a with_mpi=()
        readarray -t with_compiler <<<"${_cfg['group_deps:compiler']}"
        readarray -t with_mpi <<<"${_cfg['group_deps:mpi']}"

        local -- compiler
        local -- mpi
        for compiler in "${with_compiler[@]}"; do
                for mpi in "${with_mpi[@]}"; do
                        # build if opt_with_modules is empty or compiler is in this array
                        if (( ${#opt_with_modules[@]} != 0 )); then
                                if ! std::array::is_subset \
                                     opt_with_modules \
                                     "${compiler}" "${mpi}"; then
                                        std::info "%s " \
                                                  "Skipping build with" \
                                                  "'${compiler}'," \
                                                  "'${mpi}'"
                                        continue
                                fi
                        fi
                        pbcore::build \
                                "$1" \
                                "$2" \
                                "${compiler}" \
                                "${mpi}"
                done
        done
}

build::modules_hdf5(){
        local -n _cfg="$1"

        local -a with_compiler=()
        local -a with_mpi=()
        local -a with_hdf5=()

        readarray -t with_compiler <<<"${_cfg['group_deps:compiler']}"
        readarray -t with_mpi <<<"${_cfg['group_deps:mpi']}"
        readarray -t with_hdf5 <<<"${_cfg['group_deps:hdf5']}"

        local -- compiler
        local -- mpi
        local -- hdf5
        for compiler in "${with_compiler[@]}"; do
                for mpi in "${with_mpi[@]}"; do
                        for hdf5 in "${with_hdf5[@]}"; do
                                # build if opt_with_modules is empty or compiler is
                                # in this array
                                if (( ${#opt_with_modules[@]} != 0 )); then
                                        if ! std::array::is_subset \
                                             opt_with_modules \
                                             "${compiler}" "${mpi}" "${hdf5}"; then
                                                std::info "%s " \
                                                          "Skipping build with" \
                                                          "'${compiler}'," \
                                                          "'${mpi}'," \
                                                          "'${hdf5}'"

                                                continue
                                        fi
                                fi
                                pbcore::build \
                                        "$1" \
                                        "$2" \
                                        "${compiler}" \
                                        "${mpi}" \
                                        "${hdf5}"
                        done
                done
        done
}

build::modules_other(){
        pbcore::build \
                "$1" \
                "$2"
}

##
## build::modules_variant - build a specific varian
##
## Arguments:
##   $1 - the name of the module to build
##   $2 - the version of the module to build
##   $3 - the configuration to be used
##
build::modules_variant(){
        local -n module_config="$1"

        local -- module_name="${module_config['name']}"
        local -- module_version="${module_config['version']}"

        if [[ -n "${module_config['download_dir']}" ]]; then
                PMODULES_DISTFILESDIR="${module_config['download_dir']}"
        fi
        local -A build_functions=(
                ['Compiler']=build::modules_compiler
                ['HDF5_serial']=build::modules_hdf5_serial
                ['MPI']=build::modules_mpi
                ['HDF5']=build::modules_hdf5
        )
        local -- func=build::modules_other
        if [[ -v build_functions[${module_config['group']}] ]]; then
                func=${build_functions[${module_config['group']}]}
        fi
        ${func} \
                'module_config' \
                'BuildOpts'
}

##
## build::modules - build the modules
##
## Read the YAML configuration file, check the format and call the build
## function for given format.
##
## Note:
## For now only format 1 is supported!
##
## Arguments:
##   $1 - module name
##   $2 - version pattern
##
build::modules(){
        local -- name="$1"
        local -- version_pattern="$2"

        local -- config_yml=''
        local -i file_fmt=0
        yml::read_file config_yml "${BuildOpts['config_file']}"
        cfg::get_file_fmt file_fmt config_yml

        local -- module_config_yml=''
        case "${file_fmt}" in
                1 )
                        yml::has_key config_yml "${name}" || \
                                std::die 3 "%s " "Configuration for '${name}'" \
                                         "is missing in config file" \
                                         "- ${BuildOpts['config_file']}"
                        yml::get_value module_config_yml config_yml ".${name}" '!!map'
                        build::modules_yaml_v1 \
                                "${module_config_yml}" \
                                "${name}" \
                                "${version_pattern}"
                        ;;
                * )
                        std::die 255 "Oops!" # we should never be here!
                        ;;
        esac
}

build::modules_yaml_v1(){
        local -- yaml_module_config="$1"
        local -- name="$2"
        local -- version_pattern="$3"

        local -A mod_config_default
        std::dict::copy mod_config_default Yaml_default_config
        mod_config_default['name']="${name}"
        mod_config_default['version_pattern']="${version_pattern}"

        local -a found_keys=()
        local -a version_keys=()

        yml::get_keys  \
                found_keys \
                yaml_module_config \
                '.'

        for key in "${found_keys[@]}"; do
                case "${key}" in
                        'defaults' )
                                cfg::get_config \
                                        yaml_module_config \
                                        ".${key}" \
                                        mod_config_default
                                ;;
                        'shasums' )
                                # :FIXME: this is not safe!
                                local -- yaml_shasums=''
                                yaml_shasums=$(yq ".${key}" <<<"${yaml_module_config}" 2>/dev/null)
                                local k v
                                while read -r k v; do
                                        [[ -z ${k} ]] && continue
                                        mod_config_default[shasum:${k//:}]="${v}"
                                done <<<"${yaml_shasums}"
                                ;;
                        'type' )
                                local -- value=''
                                yml::get_value \
                                        value \
                                        yaml_module_config \
                                        ".${key}" '!!str'
                                case "${value,,}" in
                                        'module' )
                                                [[ "${BuildOpts['is_subpkg']}" == 'yes' ]] && \
                                                        cfg::err_wrong_module_type \
                                                                'mod_config_default' \
                                                                'module' 'sub_package'
                                                ;;
                                        'sub_package' )
                                                [[ "${BuildOpts['is_subpkg']}" != 'yes' ]] && \
                                                        cfg::err_wrong_module_type \
                                                                'mod_config_default' \
                                                                'sub_package' 'module'
                                                ;;
                                        * )
                                                cfg::err_invalid_module_type \
                                                        'mod_config_default' "${value}"
                                                ;;
                                esac
                                ;;
                        'versions' )
                                cfg::get_matching_version_keys \
                                        yaml_module_config \
                                        version_keys \
                                        "${version_pattern}"
                                ;;
                        * )
                                cfg::err_invalid_key \
                                        'mod_config_default' 'general config block' "${key}"
                                ;;
                esac
        done
        (( ${#version_keys[@]} > 0 )) || \
                std::die 3 "%s" "No version(s) specified in YAML configuration file."

        local -A mod_config_version=()
        local -A mod_config_variant=()

        # loop over all version keys in the YAML config file
        local -- version_key=''
        for version_key in "${version_keys[@]}"; do
                local -i num_variants=0
                std::dict::copy mod_config_version mod_config_default
                local -- node=".versions.\"${version_key}\""
                yml::get_keys \
                        found_keys \
                        yaml_module_config \
                        "${node}"
                for key in "${found_keys[@]}"; do
                        case "${key}" in
                                'config' )
                                        cfg::get_config \
                                                yaml_module_config \
                                                "${node}.config" \
                                                mod_config_version
                                        ;;
                                'variants' )
                                        # check type of node (!!seq) and query the
                                        # number of variants under the given version
                                        # key.
                                        local -- type_of_node=''
                                        yml::get_type type_of_node yaml_module_config \
                                                      "${node}.variants"
                                        [[ "${type_of_node}" == '!!seq' ]] || \
                                                cfg::err_invalid_variants_block \
                                                        'mod_config_version' \
                                                        "${type_of_node}"
                                        yml::get_seq_length \
                                                num_variants \
                                                yaml_module_config \
                                                "${node}.variants"
                                        ;;
                                * )
					cfg::err_invalid_key \
						'mod_config_version' \
						'general config block' "${key}"
                                        ;;
                        esac
                done

                # A version key in the YAML config is a semicolon-separated
                # list of version specifications, for example:
                # 42.0.0;41.0.{0..9};40.4.2
                #
		(( num_variants > 0 )) && \
			std::info "%s" "Number of variants for ${name}/${version_pattern}: ${num_variants}"
                local -a versions=()
                cfg::expand_version_key versions "${version_key}" "${version_pattern}"
                local -- version=''
                for version in "${versions[@]}"; do
                        P="${name}"
                        mod_config_version['version']="${version}"
                        cfg::parse_version "${version}"

                        if (( num_variants == 0 )); then
                                cfg::is_variant_to_build mod_config_version || \
                                        continue
				cfg::check_config mod_config_version
                                mod_config_version['version']+="${mod_config_version['suffix']}"
                                build::modules_variant mod_config_version
                        else
                                local -i n=0
                                for ((n=0; n<num_variants; n++)); do
                                        std::dict::copy mod_config_variant mod_config_version
                                        cfg::get_config \
                                                yaml_module_config \
                                                "${node}.variants[$n]" \
                                                mod_config_variant
                                        cfg::is_variant_to_build mod_config_variant || \
                                                continue
					cfg::check_config mod_config_variant

                                        mod_config_variant['version']+="${mod_config_variant['suffix']}"

                                        build::modules_variant mod_config_variant
                                        [[ "${mod_config_variant['build_variants']}" == 'first_match' ]] \
                                                && break || :
                                done
                        fi
                done
        done
} # build::modules_yaml_v1

#.............................................................................
# main

eval "$( modulecmd bash use unstable )"
eval "$( modulecmd bash use deprecated )"
eval "$( modulecmd bash use Libraries )"
eval "$( modulecmd bash use System )"

parse_args "$@"

#
# :FIXME: add comments on what we are doing and why!
#
declare -r logfile="${BUILDBLOCK_DIR}/pbuild.log"
rm -f "${logfile}"
if (( ${BuildOpts['verbose']} > 0 )); then
        exec  > >(tee -a "${logfile}")
else
        exec > >(cat >> "${logfile}")
fi
exec 2> >(tee -a "${logfile}" >&2)

#
# read runtime configuration for modbuild
#
rtcfg::read_config

declare -r BUILD_SCRIPT
declare -r BUILDBLOCK_DIR

if [[ -z ${module_name} ]]; then
        # the module name is defined by the directory the build script is in
        IFS=/ read -r -a fname <<< "${BUILD_SCRIPT:1}"
        module_name=${fname[${#fname[@]}-2]}
fi

declare version=''
for version in "${versions_to_build[@]}"; do
        build::modules "${module_name}" "${version}"
done

